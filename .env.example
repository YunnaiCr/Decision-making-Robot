# 复制成 .env 再填（.env 已在 .gitignore 里，不会被提交）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 思考开关（实测 enabled 最快且最稳）
LLM_EXTRA_JSON={"thinking": {"type": "enabled"}}

# 可选：输出上限
# LLM_MAX_TOKENS=4096

# 可选：外部数据源（高德）。不填也能跑，只是 search_remote / weather 会返回 unavailable
# AMAP_KEY=
